# Copy this file to .env and fill in your credentials
# cp .env.example .env

# ── Supabase ──────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...   # Publishable key (新版) 或 anon key (旧版) 均可

# ── Server ────────────────────────────────────────────────────
PORT=3000

# ── Supabase Setup Checklist ──────────────────────────────────
# 1. Run schema.sql in your Supabase SQL editor
# 2. Enable GitHub provider: Dashboard > Authentication > Providers > GitHub
#    Callback URL: http://localhost:3000  (add to Supabase redirect URLs too)
# 3. Enable Google provider: Dashboard > Authentication > Providers > Google
#    Callback URL: http://localhost:3000  (add to Supabase redirect URLs too)
# 4. Dashboard > Authentication > URL Configuration
#    Site URL: http://localhost:3000
#    Redirect URLs: http://localhost:3000
